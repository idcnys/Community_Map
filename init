#!/usr/bin/env bash
set -euo pipefail

OUTPUT_DIR="build/outputs"
DEBUG_INFO="build/debug-info"

echo "══════════════════════════════════════════"
echo "  CMap Release Builder"
echo "══════════════════════════════════════════"

mkdir -p "$OUTPUT_DIR"

# ── 1. Split per ABI ────────────────────────────────────────────────
echo ""
echo "▶ Building split-per-abi APKs..."
flutter clean
flutter pub get
flutter build apk --release --split-per-abi \
  --obfuscate --split-debug-info="$DEBUG_INFO"

cp build/app/outputs/flutter-apk/app-arm64-v8a-release.apk \
   "$OUTPUT_DIR/Cmap-arm64-v8a.apk"
cp build/app/outputs/flutter-apk/app-armeabi-v7a-release.apk \
   "$OUTPUT_DIR/Cmap-armeabi-v7a.apk"
cp build/app/outputs/flutter-apk/app-x86_64-release.apk \
   "$OUTPUT_DIR/Cmap-x86_64.apk"

echo "  ✓ Cmap-arm64-v8a.apk"
echo "  ✓ Cmap-armeabi-v7a.apk"
echo "  ✓ Cmap-x86_64.apk"

# ── 2. Fat APK (all ABIs) ─────────────────────────────────────────
echo ""
echo "▶ Building fat APK (all ABIs)..."
flutter clean
flutter pub get
flutter build apk --release \
  --obfuscate --split-debug-info="$DEBUG_INFO"

cp build/app/outputs/flutter-apk/app-release.apk \
   "$OUTPUT_DIR/Cmap-fat.apk"

echo "  ✓ Cmap-fat.apk"

# ── Summary ─────────────────────────────────────────────────────────
echo ""
echo "══════════════════════════════════════════"
echo "  Done! All builds in $OUTPUT_DIR/"
echo "══════════════════════════════════════════"
ls -lh "$OUTPUT_DIR"/Cmap-*.apk
